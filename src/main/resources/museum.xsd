<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://jhon0206.dev/museums/soap"
           targetNamespace="http://jhon0206.dev/museums/soap"
           elementFormDefault="qualified">

    <xs:complexType name="museumInfo">
        <xs:sequence>
            <xs:element name="id" type="xs:long" minOccurs="0"/>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="city" type="xs:string"/>
            <xs:element name="address" type="xs:string" minOccurs="0"/>
            <xs:element name="openingHours" type="xs:string" minOccurs="0"/>
            <xs:element name="admissionPrice" type="xs:decimal"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="CreateMuseumRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="name" type="xs:string"/>
                <xs:element name="city" type="xs:string"/>
                <xs:element name="address" type="xs:string" minOccurs="0"/>
                <xs:element name="openingHours" type="xs:string" minOccurs="0"/>
                <xs:element name="admissionPrice" type="xs:decimal"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="CreateMuseumResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="museum" type="tns:museumInfo"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetMuseumRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetMuseumResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="museum" type="tns:museumInfo"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="ListMuseumsRequest">
        <xs:complexType/>
    </xs:element>

    <xs:element name="ListMuseumsResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="museum" type="tns:museumInfo" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="UpdateMuseumRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
                <xs:element name="name" type="xs:string"/>
                <xs:element name="city" type="xs:string"/>
                <xs:element name="address" type="xs:string" minOccurs="0"/>
                <xs:element name="openingHours" type="xs:string" minOccurs="0"/>
                <xs:element name="admissionPrice" type="xs:decimal"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="UpdateMuseumResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="museum" type="tns:museumInfo"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="DeleteMuseumRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="DeleteMuseumResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="deleted" type="xs:boolean"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>